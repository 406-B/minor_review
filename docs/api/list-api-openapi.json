        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DishListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/dishes/new/": {
      "get": {
        "tags": ["Dishes"],
        "summary": "获取新品菜品",
        "operationId": "getNewDishes",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 10
            },
            "description": "返回数量"
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DishListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/dishes/{dish_id}/rate/": {
      "post": {
        "tags": ["Dishes"],
        "summary": "给菜品评分",
        "operationId": "rateDish",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "dish_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "rating": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 5,
                    "example": 4.5
                  }
                },
                "required": ["rating"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RateResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/dishes/{dish_id}/tags/": {
      "post": {
        "tags": ["Dishes"],
        "summary": "给菜品添加标签",
        "operationId": "addTagToDish",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "dish_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "tag_ids": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    },
                    "example": [1, 2, 3]
                  },
                  "tag_name": {
                    "type": "string",
                    "example": "新标签名称"
                  }
                },
                "anyOf": [{ "required": ["tag_ids"] }, { "required": ["tag_name"] }]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DishDetailResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/dishes/{dish_id}/tags/approve/": {
      "post": {
        "tags": ["Dishes"],
        "summary": "批准待审核标签（管理员）",
        "operationId": "approvePendingTags",
