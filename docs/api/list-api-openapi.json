{
  "openapi": "3.0.0",
  "info": {
    "title": "Minor Review - List API",
    "description": "API documentation for List module (Canteens, Dishes, Tags, Reviews)",
    "version": "1.0.0",
    "contact": {
      "name": "API Support",
      "email": "support@example.com"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8000/api",
      "description": "Development server (Django)"
    },
    {
      "url": "https://api.example.com/api",
      "description": "Production server"
    }
  ],
  "tags": [
    {
      "name": "Canteens",
      "description": "食堂相关接口"
    },
    {
      "name": "Dishes",
      "description": "菜品相关接口"
    },
    {
      "name": "Tags",
      "description": "标签相关接口"
    },
    {
      "name": "Reviews",
      "description": "评论相关接口"
    },
    {
      "name": "Profile",
      "description": "用户个人资料和偏好相关接口"
    }
  ],
  "paths": {
    "/canteens/": {
      "get": {
        "tags": ["Canteens"],
        "summary": "获取食堂列表",
        "operationId": "getCanteens",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "搜索食堂名称"
          },
          {
            "name": "ordering",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["name", "-name", "created_at", "-created_at"],
              "default": "name"
            },
            "description": "排序方式"
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 200
                    },
                    "message": {
                      "type": "string",
                      "example": "获取食堂列表成功"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Canteen"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/canteens/{canteen_id}/": {
      "get": {
        "tags": ["Canteens"],
        "summary": "获取食堂详情及菜品",
        "operationId": "getCanteenDetail",
        "parameters": [
          {
            "name": "canteen_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "tag_ids",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "description": "按标签筛选（可多个）",
            "style": "form",
            "explode": true
          },
          {
            "name": "min_rating",
            "in": "query",
            "schema": {
              "type": "number"
            },
            "description": "最低评分"
          },
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "关键词搜索"
          },
          {
            "name": "ordering",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "rating",
                "-rating",
                "view_count",
                "-view_count",
                "price",
                "-price",
                "name",
                "-name"
              ],
              "default": "-rating"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CanteenDetailResponse"
                }
              }
            }
          }
        }
      }
    },
    "/dishes/": {
      "get": {
        "tags": ["Dishes"],
        "summary": "获取菜品列表",
        "operationId": "getDishes",
        "parameters": [
          {
            "name": "canteen_id",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "按食堂筛选"
          },
          {
            "name": "tag_ids",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "description": "按标签筛选（可多个）",
            "style": "form",
            "explode": true
          },
          {
            "name": "min_rating",
            "in": "query",
            "schema": {
              "type": "number"
            },
            "description": "最低评分"
          },
          {
            "name": "min_price",
            "in": "query",
            "schema": {
              "type": "number"
            },
            "description": "最低价格"
          },
          {
            "name": "max_price",
            "in": "query",
            "schema": {
              "type": "number"
            },
            "description": "最高价格"
          },
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "关键词搜索"
          },
          {
            "name": "ordering",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "rating",
                "-rating",
                "view_count",
                "-view_count",
                "price",
                "-price",
                "name",
                "-name"
              ],
              "default": "-rating"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DishListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/dishes/{dish_id}/": {
      "get": {
        "tags": ["Dishes"],
