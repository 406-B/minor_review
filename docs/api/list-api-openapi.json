    "/dishes/{dish_id}/reviews/": {
      "get": {
        "tags": ["Reviews"],
        "summary": "获取菜品评论列表",
        "operationId": "getReviews",
        "parameters": [
          {
            "name": "dish_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "搜索评论内容或用户名"
          },
          {
            "name": "ordering",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["created_at", "-created_at", "likes_count", "-likes_count"],
              "default": "-created_at"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/dishes/{dish_id}/reviews/create/": {
      "post": {
        "tags": ["Reviews"],
        "summary": "创建评论",
        "operationId": "createReview",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "dish_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "content": {
                    "type": "string",
                    "example": "很好吃！",
                    "minLength": 5,
                    "maxLength": 1000
                  },
                  "images": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "uri"
                    },
                    "maxItems": 9,
                    "example": ["http://example.com/1.jpg"]
                  },
                  "rating_score": {
                    "type": "number",
                    "minimum": 1.0,
                    "maximum": 5.0,
                    "example": 4.5,
                    "description": "可选，如果提供则同时创建或更新评分"
                  }
                },
                "required": ["content"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "创建成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
